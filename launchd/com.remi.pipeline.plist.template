<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__RUN_SCRIPT__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>

  <key>StandardOutPath</key>
  <string>__STDOUT__</string>

  <key>StandardErrorPath</key>
  <string>__STDERR__</string>

  <!-- Catch up after the laptop was asleep at the scheduled time, rather than
       silently skipping the day. A missed run used to be indistinguishable from
       a run that found nothing. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Daily, not weekly. Stores publish on different cadences: three of the four
       change flyers on Wednesday, 99 Ranch on Friday, so no single weekday is
       right for all of them. Running every day removes the need for per-store
       cadence config entirely — a store that already has current data costs one
       database read and no network calls at all. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>__HOUR__</integer>
    <key>Minute</key>
    <integer>__MINUTE__</integer>
  </dict>
</dict>
</plist>
