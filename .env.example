# Flyer ingestion needs exactly one setting. Flipp's API is open — the
# FLIPP_ACCESS_TOKEN this file used to require no longer exists; they moved to an
# unauthenticated endpoint and the old flyerkit hosts still answer 422.
FLIPP_POSTAL_CODE=94086

# Only the chat prototype in app.py uses Vertex. Ingestion no longer reads any
# image, so the OCR provider keys that used to live here (OCR_PROVIDER,
# GEMINI/DEEPSEEK/OPENAI/OPENROUTER/NOVITA/ANTHROPIC) are gone with it.
VERTEX_SERVICE_ACCOUNT_FILE=vertex_service_account.json
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
